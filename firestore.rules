rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated player can access only their own current save.
    match /users/{userId}/saves/current {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;

      function validSave() {
        return request.resource.data.keys().hasAll([
            'schemaVersion', 'payload', 'revision', 'updatedAt', 'deviceId'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'payload', 'revision', 'updatedAt', 'deviceId',
            'sessionId', 'sessionStartedAt', 'clientSavedAt', 'checkpointType'
          ])
          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion >= 1
          && request.resource.data.payload is map
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() <= 128
          && (!('sessionId' in request.resource.data) || (request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 128))
          && (!('sessionStartedAt' in request.resource.data) || request.resource.data.sessionStartedAt is int)
          && (!('clientSavedAt' in request.resource.data) || request.resource.data.clientSavedAt is int)
          && (!('checkpointType' in request.resource.data) || (request.resource.data.checkpointType is string && request.resource.data.checkpointType.size() <= 64));
      }

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && validSave();

      // Deletion is intentionally disabled in the client rules.
      allow delete: if false;
    }

    // Deny all other client access unless a future rule explicitly permits it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}